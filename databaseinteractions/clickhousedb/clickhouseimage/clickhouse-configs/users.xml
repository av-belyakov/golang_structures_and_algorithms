<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>10000000000</max_memory_usage>
            <use_uncompressed_cache>0</use_uncompressed_cache>
            <load_balancing>random</load_balancing>
        </default>
        
        <readonly>
            <readonly>1</readonly>
        </readonly>
    </profiles>

    <users>
        <!-- replace="true" полностью заменяет блок в основном файле user.xml который находится в /etc/clickhouse-server/users.d/users.xml
        и уже содержит настройки default пользователя, в том числе и другой вид хранения пароля <password></password>, а одновременное
        использование паролей разных видов запрещено -->
        <default replace="true">
            <!-- <password></password> -->
            <password_sha256_hex>276f4ea8937dbf32828905fcc614b48df38fd65a43d818c6871a2fee5890e2bb</password_sha256_hex>
            <networks>
                <ip>0.0.0.0/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
            <!-- параметр access_management позволяет создавать и настраивать пользователей через SQL-запросы -->
            <access_management>1</access_management>
        </default>
    </users>

    <quotas>
        <default>
            <interval>
                <duration>3600</duration>
                <queries>0</queries>
                <errors>0</errors>
                <result_rows>0</result_rows>
                <read_rows>0</read_rows>
                <execution_time>0</execution_time>
            </interval>
        </default>
    </quotas>
</clickhouse>